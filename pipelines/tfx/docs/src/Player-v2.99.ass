.endmacro

longbeq .macro where
        bne *+5
        jmp @where
.endmacro

; a special version of the loadvar macro that juggles X for
; the dual filter stuffs.  Word.
loadVarIndirect   .macro table , offset 
        .export varTable
        .export @table
        .export fta
        .export ftb
        .private
        lda @table+@offset,y        ; +3
        .if useVariables=1
                .if (useAllVariables = 1) ||  (@table = wavetab2)
                        .if @table = wavetab2
                                cmp #$8a        ; +2 = 5
                        .else
                                cmp #$a3
                        .endif
                        bne next        ; +2 = 7
                        iny                ; +1 = 8
                        lda fta            ; +2 = 10
                        clc                ; +1 = 11
                        nop                ; +1 = 12
                        adc @table+@offset,y
                        tax
                        lda varTable,x
                        ldx ftb
                .endif
        next
        .endif
        .public
.endmacro

loadVar        .macro table , offset 
        .export varTable
        .export @table
        .private
        lda @table+@offset,y        ; +3
        .if useVariables=1
                .if (useAllVariables = 1) ||  (@table = wavetab2)
                        .if @table = wavetab2
                                cmp #$8a        ; +2 = 5
                        .else
                                cmp #$a3
                        .endif
                        bne next        ; +2 = 7
                        iny                ; +1 = 8
                        stx zpl                ; +2 = 10
                        txa                ; +1 = 11
                        clc                ; +1 = 12
                        adc @table+@offset,y
                        tax
                        lda varTable,x
                        ldx zpl
                .endif
        next
        .endif
        .public
.endmacro

