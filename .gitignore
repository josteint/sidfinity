# Python
__pycache__/
*.pyc
.pylocal/
.pytest_cache/
.mypy_cache/

# Compiled build artifacts
*.o
*.a
*.exe

# Vendored source trees (cloned + built by tools/build.sh)
tools/libsidplayfp/
tools/libsidplayfp/build/
tools/xa65/
tools/py65_lib/
tools/py_test_lib/
# sidid: upstream clone. The PATCH (tools/sidid_no_truncate.patch) and the
# generated classification (tools/sidid_full.txt) ARE tracked.
tools/sidid/

# Compiled binaries (rebuilt by tools/build.sh)
tools/siddump
tools/siddump_debug
tools/7zz

# Lean build outputs (regenerated by `lake build`)
.lake/

# Editor / IDE
.vscode/
*.swp
*~

# Claude Code project-local state. Track all of .claude/ EXCEPT
# scratch worktrees (large, disposable) and personal local overrides.
.claude/worktrees/
.claude/file-history/
.claude/settings.local.json

# HVSC collection (60k files, not in git — install via HVSC release)
hvsc85/

# Legacy SQLite catalogue — replaced by the git-tracked hvsc85.parquet +
# engine_docs.csv (queried via DuckDB; see src/sid_db.py). Kept out of git.
hvsc84.db

# SCRUBBED FROM HISTORY 2026-08-25, and kept out so they cannot come back.
# These four carried ~2.4 GB of raw history between them — each is a BINARY
# blob rewritten WHOLESALE on every run, so git stored a complete new copy per
# commit (hvsc84.db × 128 versions, hvsc84.csv × 72). Removing them took .git
# from 158 MB to 43 MB. The two that were still live remain ON DISK and working
# — just untracked, so a FRESH CLONE will not have them and grades.db is NOT
# regenerable; copy both by hand when moving hosts. See the READMEs in
# deprecated/gt2_grading/ and deprecated/phase0_register_roundtrip/.
# The general lesson, for any FUTURE artifact: a wholesale-rewritten binary
# does not belong in git — regenerate it, or keep it outside the tree.
hvsc84.csv
deprecated/gt2_grading/data/grades.db
deprecated/phase0_register_roundtrip/data/validation.db

# verify.py capture cache (regenerated on demand)
.verify_cache.pkl

# Rebuilt SIDs at the project root (intermediate output)
/*.sid

# Per-engine build/ scratch dirs (active outputs go to hvsc85/.../sidfinity.sid)
pipelines/hubbard/*/build/


# accidental pc-trace/hex-named dumps at repo root (e.g. siddump --pc-trace 0x7AE0 ...)
/0x*

# scratch dir for batch lists, worker tmp, probe outputs (use this, NOT /tmp)
/tmp/

# Machine-local files (branch-backup bundles, local bin) — never commit
local/

# C64 KERNAL/BASIC/CHARGEN ROM images. Copyrighted Commodore binaries — never
# commit. siddump needs them to execute RSID + C64-BASIC tunes (without them
# the BASIC interpreter never runs and every Basic_Program member verifies as
# `unsupported:too_few_steps`). Kept here as the durable copy because
# ~/.local/share/sidplayfp is not stable on this host; install with:
#   mkdir -p ~/.local/share/sidplayfp && cp tools/c64roms/* ~/.local/share/sidplayfp/
tools/c64roms/
