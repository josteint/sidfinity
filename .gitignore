# Python
__pycache__/
*.pyc
.pylocal/
.pytest_cache/
.mypy_cache/

# Compiled build artifacts
*.o
*.a
*.exe

# Vendored source trees (cloned + built by tools/build.sh)
tools/libsidplayfp/
tools/libsidplayfp/build/
tools/xa65/
tools/py65_lib/
tools/py_test_lib/

# Compiled binaries (rebuilt by tools/build.sh)
tools/siddump
tools/siddump_debug
tools/7zz

# Lean build outputs (regenerated by `lake build`)
.lake/

# Editor / IDE
.vscode/
*.swp
*~

# Claude Code project-local state — most of .claude/ stays local
# (agents/, commands/, hooks/settings, worktrees/), but the auto-memory
# directory is versioned: it carries durable session knowledge
# (project state, principles, references) that survives across sessions
# and travels with the repo. Per-subdirectory ignores rather than
# excluding all of .claude/, since gitignore can't re-include children
# of an excluded parent.
.claude/agents/
.claude/commands/
.claude/worktrees/
.claude/file-history/
.claude/worktree-checkpoint.sh
.claude/settings.json
.claude/settings.local.json
# Skills: project-skill SKILL.md files are committed individually
# (force-added when authored). The rest of each skill dir stays local.
.claude/skills/*/
!.claude/skills/migrate-hubbard-engine/SKILL.md

# HVSC collection (60k files, not in git — install via HVSC release)
hvsc84/

# verify.py capture cache (regenerated on demand)
.verify_cache.pkl

# Rebuilt SIDs at the project root (intermediate output)
/*.sid

# Per-engine build/ scratch dirs (active outputs go to hvsc84/.../sidfinity.sid)
pipelines/hubbard/*/build/

# 5_Title_Tunes split sub-binaries (regenerated by engine_constants
# on demand via tools/split_multi_binary.py)
pipelines/five_title_tunes/work_subs/
