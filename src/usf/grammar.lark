// USF grammar — see docs/usf_format.md for the human-readable contract.
//
// Lark grammar (LALR friendly). Whitespace and comments are ignored
// between tokens. Top-level order is enforced by the start rule.

start: psid_block params_block init_block top_block* instrument_block* subtune_block*

// Top-level optional blocks, grouped into ONE repeated rule (any order among
// themselves; each at most once — the parser enforces once-ness) so the LALR
// table stays small: a chain of N optionals blows up construction (the 11th
// one pushed build time from seconds to minutes; this form is O(1) per block).
top_block: environment_block | freq_table_block | offtable_vibdepth_block | state_layout_block | song_end_block | init_behavior_block | master_vol_block | sfx_block | dmc_sfx_block | default_filter_block | default_pulse_block | fc_aux_block

// ----- default (idle) filter / pulse sweeps (DMC V5) -----
// The default cutoff / PW modulation the engine applies before/between explicit
// per-instrument programs — same `swenv_args` form as a per-instrument env.
// This is PLAY-TIME content (a sweep the play loop performs), not init
// priming: the initial state stays in init.sid (the trichotomy); the
// composer continues from the priming value and applies these phases.
// Absent => the value holds at the priming value.
default_filter_block: "default_filter" "{" swenv_args "}"
default_pulse_block: "default_pulse" "{" swenv_args "}"

// FC aux tables/programs — grouped into one repeated rule (any order) so the
// LALR table stays small; a long chain of optionals blows up construction.
fc_aux_block: arp_programs_block | pulse_programs_block | filter_programs_block | filter_mod_block | drum_programs_block | wave_programs_block | attack_len_decl | attack_wave_decl | wave_arp_decl | pulse_arp_decl

// ----- arp programs (FC arpeggio library) -----
// `prog N: [o0, o1, ...]` — N is the arp index selected by a pattern $7x
// command; the list is the semitone-offset cycle (count byte = len-1).
arp_programs_block: "arp_programs" "{" arp_program* "}"
arp_program: "prog" INT ":" "[" (signed_int ("," signed_int)*)? "]"

// ----- pulse programs (FC pulse-width-sweep library) -----
// `prog N: lo=L hi=H [wrap] seg T S [flip] (x3)` — PW ramps between
// bounds L/H, switching step S when a counter crosses threshold T.
// `flip` after a segment reverses sweep direction at that threshold;
// `wrap` snaps at the bound instead of bouncing. Exactly 3 segments.
pulse_programs_block: "pulse_programs" "{" pulse_program* "}"
pulse_program: "prog" INT ":" "lo" "=" number "hi" "=" number pp_wrap? pp_seg pp_seg pp_seg
pp_wrap: "wrap"
pp_seg: "seg" number number pp_flip?
pp_flip: "flip"

// ----- filter programs (FC filter cutoff-envelope library) -----
// `prog N: init=I d418=D final=F end=E seg T A (x3)` — cutoff starts at I,
// adds A as a counter crosses threshold T, snaps to F past E; D = $D418.
filter_programs_block: "filter_programs" "{" filter_program* "}"
// Time-keyed cutoff envelope: init cutoff (from `onset` elapsed frames,
// default 0 = note start), then (threshold, add) ramp segments — cutoff
// += add per frame while in a segment's window — until `end`, where the
// cutoff holds at `final`. Tel programs have 3 segments and no onset;
// the standard FC program has 4 segments + an explicit onset threshold.
filter_program: "prog" INT ":" "init" "=" number ("onset" "=" number)? "d418" "=" number "final" "=" number "end" "=" number fp_seg+
// Duration-based cutoff envelope (DMC shape): res = resonance nibble,
// mode = SID filter mode bits (LP/BP/HP mask), init = starting cutoff,
// repeat = step index looped to after the last step, stop = cutoff
// value that freezes the envelope. Each step(d, f) adds d (signed) to
// the cutoff every frame for f frames. Same musical concept as the
// threshold-based shape above — a different point in the same
// piecewise-linear-envelope parameter space.
              | "prog" INT ":" "res" "=" number "mode" "=" number "init" "=" number "repeat" "=" INT "stop" "=" number fp_step+   -> filter_program_dur
fp_step: "step" "(" signed_int "," INT ")"
fp_seg: "seg" number number

// ----- global filter-cutoff modulation (song-global looped LFO) -----
// A free-running cutoff contour that advances one position per play()
// call for the whole song: `start` is the contour value at position 0
// and each step(d, f) adds d per frame for f frames (the same
// piecewise-constant-rate form as the duration-based filter program;
// the step frames sum to the contour period, and the deltas sum to 0
// mod 256 so the loop closes). Each frame, prog N's `init` cutoff takes
// the contour value at (init_phase + t) mod period and its `stop`
// cutoff the value at (stop_phase + t) — two phase-offset taps of one
// LFO. The engine samples both at filter note-init, so musically every
// filter note starts (and freezes) wherever the LFO currently sits.
filter_mod_block: "filter_mod" "{" filter_mod_entry* "}"
filter_mod_entry: "prog" INT ":" "start" "=" number "init_phase" "=" INT "stop_phase" "=" INT fp_step+

// ----- drum programs (FC percussion library) -----
// `drum N: wave=[..] tone=[..]` — parallel per-step waveform ($D404) and
// pitch-offset lists. Program length = len(wave)+1 (leading byte derived).
drum_programs_block: "drum_programs" "{" drum_program* "}"
drum_program: "drum" INT ":" "wave" dnum_list "tone" dnum_list
dnum_list: "=" "[" (number ("," number)*)? "]"

// ----- wave programs (FC standard-player wave/freq envelope library) -----
// `prog N: ctrl=[..] freq=[..] [loop=K]` — parallel per-frame waveform
// ($D404) and freq ($D400/01) tables, indexed by the note frame-counter
// (capped 15); `loop=K` wraps the program at step K. The composer lays
// programs at sel*16 stride and derives the pointer tables. DMC v5 uses
// prog 0 as the idle wave a resting voice freewheels through.
wave_programs_block: "wave_programs" "{" wave_program* "}"
wave_program: "prog" INT ":" "ctrl" dnum_list "freq" dnum_list ("loop" "=" INT)?

// ----- FC flat aux value tables -----
// attack_len/attack_wave: per-wavecount note-attack; wave_arp/pulse_arp:
// cyclic waveform / pulse-hi arpeggio sequences.
attack_len_decl:  "attack_len" dnum_list
attack_wave_decl: "attack_wave" dnum_list
wave_arp_decl:    "wave_arp" dnum_list
pulse_arp_decl:   "pulse_arp" dnum_list

// ----- psid -----
psid_block: "psid" "{" psid_field+ "}"
psid_field: "title" ":" STRING       -> psid_title
          | "author" ":" STRING      -> psid_author
          | "released" ":" STRING    -> psid_released
          | "clock" ":" CNAME        -> psid_clock
          | "sid" ":" INT            -> psid_sid
          | "sid" ":" CNAME          -> psid_sid_name
          // Multi-SID (2SID/3SID): the SID MODEL of the second/third chip,
          // present ONLY when the header states one explicitly (Unknown =
          // "same as the first SID" per the PSID spec, elided here). Chip
          // COUNT is derived from the subtunes' voice-block count; chip
          // ADDRESSES are pipeline constants (chip 2 = $D420, chip 3 =
          // $D440), never USF content.
          | "sid2" ":" INT           -> psid_sid2
          | "sid2" ":" CNAME         -> psid_sid2_name
          | "sid3" ":" INT           -> psid_sid3
          | "sid3" ":" CNAME         -> psid_sid3_name
          | "start_song" ":" INT     -> psid_start_song
          // PSID speed bitmask: bit N set = subtune N is CIA-timed
          // (play() at the CIA rate), clear = VBI 50 Hz.
          | "speed" ":" number       -> psid_speed

// ----- params -----
params_block: "params" "{" params_field* "}"
params_field: CNAME ":" param_value
param_value: signed_int      -> param_number
           | CNAME           -> param_keyword
           | bool            -> param_bool
           // Named readable knob values (e.g. a per-event write-order
           // declaration "v1_fhi v1_flo v1_gate") — the alternative is packing
           // structure into opaque ints, the representation-principle §3
           // failure mode.
           | STRING          -> param_string

// ----- init -----
// `init_inner*`: each entry is either an init_voice (engine-state
// priming — per-voice runtime state the play loop reads on tick 1)
// OR an init_sid_block (SID-chip priming — master_vol, filter,
// per-voice envelope_prime / pw_init). See docs/the_trichotomy.md
// for the trichotomy. Both are optional; an empty `init { }` block
// means "no overrides, use composer defaults."
init_block: "init" "{" init_inner* "}"
init_inner: init_voice | init_sid_block | init_slide_phase
// Global engine-state priming (trichotomy §4.5, scalar): initial phase
// bit of the shared half-rate slide clock (dual-effect update parity).
init_slide_phase: "slide_phase" ":" number

// Common (Hubbard-'85-shaped) voice-state fields: ctrl (SID ctrl byte
// at engine init), dur_field (vibrato carry-path initial duration),
// pwm_period (PWM accumulator), pwm_dir (up/down), instr (starting
// instrument ref), slide_v (cached freq-hi for the skydive effect).
init_voice: "voice" INT "{" init_field+ "}"
init_field: CNAME ":" init_value
init_value: number           -> init_number
          | CNAME            -> init_keyword
          | instr_ref        -> init_instr

// ----- init.sid (optional) -----
// SID-chip priming the engine performs during init. The composer's
// universal init reads these and emits the corresponding SID writes
// after the silence-clear reset. All sub-fields are optional;
// missing fields mean "don't prime that slot."
// The optional INT is the chip index (2/3) for multi-SID members; chip 1
// (the only chip of an ordinary SID) is always the bare `sid { }` form.
init_sid_block: "sid" INT? "{" init_sid_field* "}"
init_sid_field: "master_vol" ":" number                       -> isid_master_vol
              | "filter" "{" init_filter_field+ "}"           -> isid_filter
              | "voice" INT "{" isid_voice_field+ "}"         -> isid_voice
init_filter_field: "cutoff_lo" ":" number      -> ifilt_lo
                 | "cutoff_hi" ":" number      -> ifilt_hi
                 | "res_routing" ":" number    -> ifilt_res
isid_voice_field: "envelope_prime" ":" "(" number "," number ")"  -> isidv_env
                | "pw_init" ":" number                              -> isidv_pw
                | "ctrl_init" ":" number                            -> isidv_ctrl
                | "freq_init" ":" number                            -> isidv_freq

// ----- environment (optional) -----
// The trichotomy's ENVIRONMENT category (§4.3): how the host drives
// play() — temporal, never SID state. cia_period = the CIA1 timer A
// latch (multispeed rate; absent = vblank). play_repeat = whole-play()
// repeats per VBI (ledger C24). Engines without these omit the block.
environment_block: "environment" "{" environment_field* "}"
environment_field: "cia_period" ":" number    -> env_cia_period
                 | "play_repeat" ":" INT      -> env_play_repeat

// ----- freq table (optional) -----
// Per-tune freq table bytes. The codegen places them at the canonical
// freq-table address. When present, the build path doesn't need to
// look up engine constants for the freq region — the tune is
// self-contained.
freq_table_block: "freq_table" "{" byte_list "}"
// (Off-table freq reads are now carried per-instrument as `offtable_freq`
// — the old `freq_overrun` opaque-window block was removed 2026-06-21.)

// Off-table vibrato-depth reads (DMC v4): note-keyed vibrato depths for notes
// that overshoot the 96-entry vibdepth table (note > 95). at(note, depth).
offtable_vibdepth_block: "offtable_vibdepth" "{" ovd_entry+ "}"
ovd_entry: "at" "(" number "," number ")"

// ----- state_layout (optional) -----
// Off-table-arp statebuf layout — names which bytes the engine reads
// when a note has pitch >= 96. Default (omitted) = the 3-voice
// Commando family layout. Human Race emits its own 2-voice layout.
state_layout_block: "state_layout" "{" sl_field+ "}"
sl_field: "n_voices" ":" INT                          -> sl_n_voices
        | "scalar" INT "const" byte                    -> sl_scalar_const
        | "scalar" INT "var" CNAME                     -> sl_scalar_var
        | "per_voice" INT "const" byte                 -> sl_pv_const
        | "per_voice" INT "var" CNAME                  -> sl_pv_var

// ----- song_end (optional) -----
// End-of-orderlist behavior — what the `$FE` STOP marker and `$FF`
// LOOP marker actually do. Replaces the flat per-tune params keys
// `freeze_on_stop` / `stop_fill` / `loop_silences_song`.
song_end_block: "song_end" "{" song_end_field+ "}"
song_end_field: "stop_marker" ":" CNAME       -> se_stop_marker
              | "fill_value" ":" number       -> se_fill_value
              | "loop_marker" ":" CNAME       -> se_loop_marker

// ----- init_behavior (optional) -----
// Engine first-frame play behavior — replaces flat per-tune flags
// `first_frame_gate_off` and `suppress_first_notestart`.
init_behavior_block: "init_behavior" "{" init_behavior_field+ "}"
init_behavior_field: "silence_all_voices_on_frame_0" ":" bool   -> ib_silence_all
                   | "no_first_attack_voice" ":" INT             -> ib_no_first_attack
                   | "master_vol_every_frame" ":" number         -> ib_master_vol_every_frame
                   | "master_vol_every_note" ":" number          -> ib_master_vol_every_note

// ----- master_vol (optional) -----
// Master-volume modulation algorithm — replaces 5 flat per-tune
// `master_vol_*` keys (one musical concept, scattered). The fade is
// vol = clamp(base - subtrahend_voice's orderlist position, 0..$0F),
// advanced per `trigger`; see .claude/memory/project_hubbard_song_end_fade.md.
master_vol_block: "master_vol" "{" master_vol_field+ "}"
master_vol_field: "subtrahend_voice" ":" INT       -> mv_subtrahend_voice
                | "base" ":" number                -> mv_base
                | "trigger" ":" CNAME              -> mv_trigger
                | "reset_on_loop" ":" bool         -> mv_reset_on_loop
                | "underflow_clamp" ":" bool       -> mv_underflow_clamp

// ----- sfx (optional) -----
// SFX sub-engine bookkeeping — replaces flat `has_sfx` +
// `sfx_framectr_ofs` + `sfx_state_ofs`. Presence of the block
// signals SFX presence; addresses inside are engine-positional but
// per-tune-stable.
sfx_block: "sfx" "{" sfx_kv* "}"
sfx_kv: "framectr_ofs" ":" number       -> sfx_framectr_ofs
      | "state_ofs" ":" number          -> sfx_state_ofs

// ----- dmc_sfx embedded sub-player (optional) -----
// The shared musical content of the embedded dmc_sfx SFX sequencer packed into
// some DMC compilations (Canyon_Tank_Duel). `filter_lfo` = a rotating cutoff
// contour; `wave_table` = the arp pitch-program; `freq_lo/hi` = the tuning
// tables (extended to cover off-table reads). Each instrument's 4-entry
// `ctrl`/`freqbase` tables are a per-frame timbre + base-pitch modulation.
// See src/usf/types.py SfxEngine + pipelines/dmc/v4/RE_NOTES.md 'dmc_sfx'.
dmc_sfx_block: "dmc_sfx" "{" dmc_sfx_field* "}"
dmc_sfx_field: "init_counter" ":" number            -> dsfx_counter
             | "live_counter_fidx" ":" signed_int   -> dsfx_live
             | "filter_lfo" ":" byte_list            -> dsfx_filter
             | "wave_table" ":" byte_list            -> dsfx_wave
             | "freq_lo" ":" byte_list               -> dsfx_freqlo
             | "freq_hi" ":" byte_list               -> dsfx_freqhi
             | dsfx_instrument
             | dsfx_song
             | dsfx_voice_init
dsfx_instrument: "instrument" INT "{" "ctrl" ":" byte_list "freqbase" ":" byte_list "ad" ":" number "sr" ":" number "pw" ":" number number "}"
dsfx_song: "song" INT "{" "voice" ":" number "duration" ":" number "wavestep" ":" number "increment" ":" number "instrument" ":" number "}"
dsfx_voice_init: "voice_init" INT "{" "duration" ":" number "pitch" ":" number "increment" ":" number "wavestep" ":" number "instrument" ":" number "}"

// ----- instruments -----
instrument_block: "instrument" INT instrument_name? "{" instrument_field+ "}"
instrument_name:  CNAME
instrument_field: "waveform" ":" byte_list                              -> inst_waveform
                | "loop" ":" INT                                        -> inst_loop
                // Parallel per-step freq values for the waveform
                // envelope: each waveform step also has a pitch value —
                // a signed semitone offset added to the note (arpeggio),
                // or an absolute freq-hi byte when the instrument has
                // the `drum` effect. Same musical concept as the FC
                // standard wave program's dual ctrl/freq tables. (DMC)
                | "wave_freq" ":" "[" (signed_int ("," signed_int)*)? "]" -> inst_wave_freq
                | "pwm" ":" pwm_args                                    -> inst_pwm
                | "adsr" ":" byte byte                                  -> inst_adsr
                | "arp" ":" arp_args                                    -> inst_arp
                | "vibrato" ":" vib_args                                -> inst_vibrato
                | "envelope" ":" env_args                               -> inst_envelope
                | "slide" ":" slide_args                                -> inst_slide
                | "incby2" ":" incby2_args                              -> inst_incby2
                // FC v1 — decomposed instrument effects (replaces v0's
                // four opaque fc_fil_count/fc_fx1-3 bytes). See
                // pipelines/future_composer/docs/usf_schema_v1.md.
                | "pulse_prog" ":" pulse_prog_args                      -> inst_pulse_prog
                | "filter_prog" ":" filter_prog_args                    -> inst_filter_prog
                // DMC V5 — per-instrument pulse-width / filter-cutoff sweep
                // envelope: start value, optional `repeat` (loop phase),
                // then `seg (rate, frames)` phases.
                | "pulse_env" ":" swenv_args                              -> inst_pulse_env
                | "filter_env" ":" swenv_args                             -> inst_filter_env
                | "effects" ":" effects_args                            -> inst_effects
                // DMC V5 off-table arpeggio frequency: when a freq lookup index
                // (offset+note) runs past the 96-entry freq table into engine
                // state, that state byte is played as a frequency. Captured as
                // the EXPLICIT 16-bit freq produced, keyed by (offset, effective
                // note): `at(offset, note, freq_lo, freq_hi)`; idx=(offset+note).
                // offset = a wave step's semitone offset, or 0 for the base read
                // (vib step / note freq / glide arrival). The off-table-read form.
                | "offtable_freq" ":" ofreq_entry+                      -> inst_offtable_freq
                // The instrument's position in the editor's SHARED wave
                // table (a number the composer typed — arrangement).
                // Carried only when an off-table freq read sonifies a
                // voice's live wave position; the composer packs its wave
                // pool at these positions so its wave-position state equals
                // the sonified value.
                | "wave_table_pos" ":" INT                              -> inst_wave_table_pos
                // The editor started this instrument's wave ON its own loop
                // marker ("start at the loop marker" idiom); the engine's
                // first-read chase writes the shared $171F scratch. Carried
                // only when an off-table freq read sonifies that scratch.
                | "wave_start_on_marker" ":" INT                        -> inst_wave_start_on_marker

// off-table arpeggio freq entry: at(offset, note, freq_lo, freq_hi).
// `at(...)` = the read sonifies a FIXED byte (served from the captured lo/hi);
// `live(...)` = the read sonifies a live-varying engine value (a duration
// counter, freq accumulator, sector/wave position, speed/master-vol) that the
// composer reproduces from its own equivalent state. A behavioral property of
// the sound, not a memory-geometry descriptor. Absent `live` marker => static.
ofreq_entry: "at" "(" number "," number "," number "," number ")"    -> ofreq_static
           | "live" "(" number "," number "," number "," number ")"  -> ofreq_live

pwm_args: pwm_kv+
pwm_kv: "mode" "=" CNAME           -> pwm_mode
      | "speed" "=" INT            -> pwm_speed
      | "init" "=" number          -> pwm_init
      | "min_hi" "=" INT           -> pwm_min_hi
      | "max_hi" "=" INT           -> pwm_max_hi
      | "phase1_dir" "=" CNAME     -> pwm_phase1_dir
      | "phase1_bound" "=" number  -> pwm_phase1_bound
      | "phase1_step" "=" number   -> pwm_phase1_step
      | "lo_or_mask" "=" number    -> pwm_lo_or_mask
      // Per-direction-flip step-rate schedule: the PW ramp rate changes
      // as the oscillation progresses (DMC's 6 phases). Each value is
      // the effective per-frame step. Empty = constant `speed`.
      | "speed_steps" "=" "[" (INT ("," INT)*)? "]" -> pwm_speed_steps
      // Keep the PW oscillator running across note boundaries (no
      // reset at note init) — legato pulse texture. (DMC flag $04)
      | "keep_running" "=" bool    -> pwm_keep_running

arp_args: arp_kv+
arp_kv: "offsets" "=" "[" (signed_int ("," signed_int)*)? "]"   -> arp_offsets
      | "period" "=" INT                                          -> arp_period
      | "interval" "=" INT                                        -> arp_interval
      | "phase_invert" "=" bool                                   -> arp_phase_invert

vib_args: vib_kv+
vib_kv: "scale" "=" INT                 -> vib_scale
      | "onset" "=" INT                 -> vib_onset
      | "shape" "=" CNAME               -> vib_shape
      | "period_frames" "=" INT         -> vib_period_frames
      | "polarity" "=" CNAME            -> vib_polarity
      | "depth_semitones" "=" FLOAT     -> vib_depth_semitones
      // FC v1 — added to express the engine's amplitude/speed/direction
      // bit-fields as named musical scalars. Independent of Hubbard's
      // scale/onset (different engines parameterise vibrato differently
      // but they all write to the same conceptual block).
      | "amplitude" "=" INT             -> vib_amplitude
      | "speed" "=" INT                 -> vib_speed
      | "direction" "=" CNAME           -> vib_direction
      // Swell ramp: vibrato depth DOUBLES each half-cycle until the
      // ramp counter reaches this value (0 = fixed depth). (DMC)
      | "ramp" "=" INT                  -> vib_ramp

// FC v1 — pulse-program config (replaces opaque fc_fx2 byte).
// `program` selects the engine's `pulsetabel` entry (1-7; 0 = disabled).
// `increment` is the per-frame pulse-width step (0-15 → scaled by 16
// when encoded back into fx2's high nibble).
pulse_prog_args: pulse_prog_kv+
pulse_prog_kv: "program" "=" INT        -> pp_program
             | "increment" "=" INT      -> pp_increment

// FC v1 — filter-program config (replaces opaque fc_fil_count byte +
// fx2 bit 3 + fx3 bit 0). `program` selects the engine's filter program
// (1-15; 0 = disabled). `strange` enables the bidirectional cutoff
// sweep. `double_voice` is the lo-freq detune trick. `aux_bits` carries
// the high-nibble bits of fil_count whose musical meaning isn't yet
// fully RE'd (v2 deferral). For DMC V5, `program` is the entry index into
// the tune's shared `pulse_table` / `filter_table`.
// DMC V5 sweep envelope: `start` value, optional `repeat` (loop-back phase
// index — placed before the phases to keep the rule LALR(1)-unambiguous;
// `repeat` is an established keyword), then `seg (rate, frames)` phases.
swenv_args: "start" "=" number ("repeat" "=" INT)? swenv_seg*
swenv_seg: "seg" "(" signed_int "," number ")"

filter_prog_args: filter_prog_kv+
filter_prog_kv: "program" "=" INT       -> fp_program
              // Filter program continues across note boundaries (no
              // re-init at note start) — legato filter. (DMC flag $02)
              | "keep_running" "=" bool -> fpc_keep_running
              | "strange" "=" bool      -> fp_strange
              | "double_voice" "=" bool -> fp_double_voice
              | "aux_bits" "=" number   -> fp_aux_bits

// FC v1 — instrument effect flags (replaces opaque fc_fx3 bits 1-7
// plus a flag for fx3 bit 0). Each name is a flag that's PRESENT if
// the corresponding bit is set in the original instrument's fx3 byte.
effects_args: effect_name+
effect_name: "tone_arp"        -> efx_tone_arp
           | "pulse_arp"       -> efx_pulse_arp
           | "drum"            -> efx_drum
           | "tonesweep_up"    -> efx_tonesweep_up
           | "wave_arp"        -> efx_wave_arp
           | "noise_tick"      -> efx_noise_tick
           | "pulse_run"       -> efx_pulse_run
           | "filter_program"  -> efx_filter_program
           // First-frame noise burst: note attacks with max-freq gated
           // noise for one frame before the wave envelope starts.
           // (DMC cymbal flag $80)
           | "noise_attack"    -> efx_noise_attack

env_args: env_kv+
env_kv: "release_ctrl" "=" number      -> env_release_ctrl
      // Gate articulation: 'hold' (gate until note end — the classic
      // tracker model, default), 'release_early' (gate drops a fixed
      // few frames after attack; the tail rides the SID release —
      // DMC's percussive default), 'open' (gate never drops).
      | "gate_mode" "=" CNAME          -> env_gate_mode
      // The never-release toggle is ALSO set alongside hold (the two
      // are independent editor flags; hold takes articulation
      // priority). Elidable — emitted only when true.
      | "gate_open" "=" number         -> env_gate_open

// Phase 1: per-instrument freq-slide config — replaces the per-
// engine-parameterized `fx: freq_slide` flag.
slide_args: slide_kv+
slide_kv: "mode" "=" CNAME                  -> slide_mode
        | "initial_dir" "=" CNAME           -> slide_initial_dir
        | "upper_delta" "=" signed_int      -> slide_upper_delta
        | "lower_delta" "=" signed_int      -> slide_lower_delta
        | "step" "=" number                 -> slide_step
        | "high_oct_arp" "=" bool           -> slide_high_oct_arp
        // Slide updates every OTHER frame (a global half-rate clock
        // shared by all sliding voices). (DMC dual effect)
        | "half_rate" "=" bool              -> slide_half_rate

// Phase 1: per-instrument inc_by2 config — replaces the per-engine-
// parameterized `fx: inc_by2` flag.
incby2_args: incby2_kv+
incby2_kv: "mode" "=" CNAME                 -> incby2_mode
         | "step" "=" signed_int            -> incby2_step
         | "onset" "=" INT                  -> incby2_onset
         | "late_gate" "=" INT              -> incby2_late_gate
         | "every_frame" "=" bool           -> incby2_every_frame

// ----- subtunes -----
subtune_block: "subtune" INT subtune_kind "{" subtune_body "}"
subtune_kind: "music"        -> kind_music
            | "digi"         -> kind_digi
            | "sfx"          -> kind_sfx
            | "dmcsfx"       -> kind_dmcsfx

subtune_body: music_body
            | digi_body
            | sfx_body
            | dmcsfx_body

// dmcsfx — a subtune played by the embedded dmc_sfx sub-player. All content
// lives in the shared `dmc_sfx` block; the subtune only names its song.
dmcsfx_body: "song" ":" INT

// music
// `is_sfx`: FC family — distinguishes SFX-kind subtunes that are
// structurally identical to music (3-voice note streams) but whose
// runtime semantics differ (engine doesn't sustain gate on song-end).
// Multi-SID: 3 voice blocks per chip (voices 1-3 = chip 1, 4-6 = chip 2,
// 7-9 = chip 3 — the chip is derived from the voice number, never stated);
// the parser validates the count is exactly 3, 6 or 9 and the numbering
// consecutive. `tempo N:` (N = 2/3) is that chip's tempo when it differs
// from chip 1's; one `global` block per chip, the bare form = chip 1.
music_body: "tempo" ":" INT tempo_chip* is_sfx_field? params_block? init_block? voice_block+ global_block*
tempo_chip: "tempo" INT ":" INT
is_sfx_field: "is_sfx" ":" bool

// ----- global automation track (optional) -----
// Chip-global musical state that varies over the song: DYNAMICS (master
// volume) and FILTER (cutoff / resonance / mode / routing) — the SID's
// only global ($D415-$D418) controls, which aren't per-voice so they can't
// ride a NoteRow. A sparse sequence of events keyed by step index; each
// names the fields that change (running-state carry for the rest). The
// composer re-packs these into the $D415-$D418 bytes at the template
// positions: $D418=(mode<<4)|dyn, $D417=(res<<4)|route, $D416=cutoff.
// The optional INT is the chip index (2/3); bare `global { }` = chip 1.
global_block: "global" INT? "{" global_event* "}"
global_event: "at" INT g_field+
g_field: "dyn" "=" number      -> g_dyn
       | "cutoff_lo" "=" number  -> g_cutoff_lo
       | "cutoff" "=" number    -> g_cutoff
       | "res" "=" number       -> g_res
       | "mode" "=" number      -> g_mode
       | "route" "=" number     -> g_route

// `orderlist stated:` = the PHYSICAL de-unrolled track form (DMC): entry
// modifiers are STATED transpose commands (absent = inherit; state carries
// over the loop wrap), `~b` = intro-pass decode variant, `!k` = k extra dead
// command bytes. Plain `orderlist:` = per-entry EFFECTIVE transposes (FC).
voice_block: "voice" INT "{" "orderlist" ol_stated? ":" orderlist pattern_block* "}"
ol_stated: "stated"
orderlist: orderlist_entry+ orderlist_terminator?
         | orderlist_terminator
// entry: a[*b][+c][^d]  — a=pattern id, b=repeats, c=transpose, d=voiceinc.
// Operand first, then a homogeneous list of <operator><parameter> modifiers.
orderlist_entry: INT ol_intro? ol_repeat? (ol_transpose | ol_transpose_neg)? ol_extra? ol_voiceinc?
ol_intro: "~" INT
ol_extra: "!" INT
ol_repeat: "*" INT
ol_transpose: "+" INT
ol_transpose_neg: "-" INT
ol_voiceinc: "^" INT
// loop@N len=L — the loop PICKS UP note length L (ticks): the engine's
// length state carries over the wrap, so the head pattern's first note
// (which states no length) plays pass 1 at its written duration and
// passes 2+ at L. May combine with the transpose pickup: loop@N+T len=L.
ol_looplen: "len" "=" INT
// loop@N — wrap to entry N, the head re-establishing its stated
// transpose. loop@N+T — wrap CARRYING transpose T over (the engine's
// state persists; the head plays passes 2+ under T — standard FC).
orderlist_terminator: "loop" "@" INT (ol_transpose | ol_transpose_neg)? ol_looplen?  -> ol_loop
                    | "stop"                        -> ol_stop

pattern_block: "pattern" INT "length" "=" INT "{" note_row* "}"

note_row: pitch INT instr_ref? fx_flag*
pitch: NOTE_NAME      -> pitch_named
     | "---"          -> pitch_rest
fx_flag: "tie"                  -> fx_tie
       | "no_release"           -> fx_no_release
       | "porta" "=" INT        -> fx_porta
       | "tempo" "=" INT        -> fx_tempo
       | "vol" "=" INT          -> fx_vol
       | "song_pos" "=" INT     -> fx_song_pos
       | "section_end" "=" INT  -> fx_section_end
       | "set_dur" "=" number   -> fx_set_dur
       // DMC V5 sticky instrument-select ($FC), positioned in the event
       // stream (its byte position is read by the engine's gate-off
       // lookahead, so it stays an ordered row marker, not a per-note tag).
       | "set_instr" "=" INT    -> fx_set_instr
       // DMC V5 positioned sector commands (ordered prefix markers on the
       // following note/gate row): filter freq-hi override ($F8), master
       // fade in/out ($F7/$F6), live AD/SR register writes ($F2/$F1).
       | "frq" "=" number       -> fx_frq
       | "fade_in" "=" number   -> fx_fade_in
       | "fade_out" "=" number  -> fx_fade_out
       | "adr" "=" number       -> fx_adr
       | "srr" "=" number       -> fx_srr
       // DMC V5 family-4 positioned sector commands: per-voice freq-lo
       // BIAS ($EF -> $1842,x, added in the wave-step) and the per-note
       // wave/vib setup command ($F0), decomposed into its two engine-
       // semantic sub-fields (low 3 bits = vib width -> $1856; high nibble
       // = wave count -> $1809,x) rather than the raw packed byte.
       | "freq_bias" "=" number      -> fx_freq_bias
       | "f0_vib_width" "=" INT       -> fx_f0_vib_width
       | "f0_wave_count" "=" INT      -> fx_f0_wave_count
       // DMC V5 gate-mask-toggle tie ($F4): hold current note one more
       // duration AND flip the gate bit (vs `tie` = plain hold $FE).
       | "gate_tie"             -> fx_gate_tie
       | "fx" ":" CNAME         -> fx_named
       // FC family musical attributes (new in v0). Glide = portamento
       // with an N-frame onset delay; wave_adjust = per-note wave-table
       // offset; filter = direct $D417 write.
       | "glide" "=" INT        -> fx_glide
       // Standard-FC directional portamento: a constant per-frame rate
       // (16-bit) toward up/down, starting after `glide_onset` ticks of
       // the note. Same musical concept as `glide` (Tel: slide-to-target
       // with delay) — a different point in the portamento parameter
       // space (direction+rate+onset vs target+delay).
       | "glide_up" "=" number    -> fx_glide_up
       | "glide_down" "=" number  -> fx_glide_down
       | "glide_onset" "=" INT    -> fx_glide_onset
       // Discrete slide granularity: the number of rate-sized updates the
       // glide performs over the row (basic_program trace-lift; engines
       // whose glide ticks at the player's own loop rate, not per-frame).
       | "glide_ticks" "=" INT    -> fx_glide_ticks
       // Slide step-hold: each level of the glide is held for this many
       // ticks before advancing (a staircase ramp; default 1 = advance
       // every tick).
       | "glide_hold" "=" INT     -> fx_glide_hold
       | "wave_adjust" "=" INT  -> fx_wave_adjust
       | "filter" "=" number    -> fx_filter
       // FC $F0 marker: play this note WITHOUT retriggering the
       // instrument (skip ADSR/wave reload) — legato to a new pitch.
       | "noretrig"             -> fx_noretrig
       // Gate-mask toggle event: flips the voice's gate bit for this
       // row's duration slot without pitch change (DMC SWITCH $7D).
       | "gate_toggle"          -> fx_gate_toggle
       // Two-pitch glide: the row attacks at its own pitch and glides
       // to this target (DMC GLD mode 0). With `noretrig`, the glide
       // starts from the sounding note instead (DMC slide mode 1);
       // speed comes from the existing `glide=N` flag.
       | "glide_to" "=" NOTE_NAME -> fx_glide_to
       // Stated-command placement (arrangement): this editor row carries
       // an explicit duration / instrument / volume command (dur_cmd / instr_cmd /
       // vol_cmd), or N no-hard-restart mode toggles (soft_cmd), even where the
       // value did not change. Emitted only when an engine sonifies its
       // pattern-position counter (DMC sectpos $1729 read off-table): the
       // composer derives each row's byte width from row kind + these flags.
       | "dur_cmd"                 -> fx_dcmd
       | "instr_cmd"                 -> fx_icmd
       | "vol_cmd"                 -> fx_vcmd
       | "soft_cmd" "=" INT      -> fx_softcmd

// digi
digi_body: "sample" ":" SAMPLE_PATH

// sfx — Hubbard '85 sound-effect record
sfx_body: sfx_field+
sfx_field: "v1" ":" byte byte byte byte byte byte           -> sfx_v1
         | "v2" ":" byte byte byte byte byte byte           -> sfx_v2
         | "sweep" ":" sfx_sweep_kv+                         -> sfx_sweep
         | "v2_offset" ":" byte                              -> sfx_v2_offset
         | "flags" ":" sfx_flag+                             -> sfx_flags
         | "extended_freq" "{" ext_freq_entry+ "}"           -> sfx_extended_freq

sfx_sweep_kv: "start" "=" byte             -> sfx_sweep_start
            | "end" "=" byte               -> sfx_sweep_end
            | "rate" "=" INT               -> sfx_sweep_rate
            | "direction" "=" CNAME        -> sfx_sweep_direction

sfx_flag: "toggle_v1"   -> sfx_flag_toggle_v1
        | "toggle_v2"   -> sfx_flag_toggle_v2
        | "skip_v1"     -> sfx_flag_skip_v1
        | "skip_both"   -> sfx_flag_skip_both

// extended_freq — per-SFX freqtab overlay: `offset: value` pairs naming
// the bytes the sweep reads when its index lands past the 96-entry
// musical region (sfx_y ≥ 192, or V2 sweep_y underflows). The composer
// overlays these onto the synthesized freq-table block before assembly.
ext_freq_entry: byte ":" byte               -> ext_freq_pair

// ----- common -----
instr_ref: INSTR_ID             -> instr_id
         | INSTR_NAME           -> instr_name

INSTR_ID.3:   "i" /[0-9]+/
INSTR_NAME.3: "i:" /[A-Za-z_][A-Za-z0-9_]*/

byte_list: byte+
byte: number
number: INT       -> dec_number
      | HEX       -> hex_number
signed_int: number
          | "-" number          -> neg_number
bool: "true"      -> bool_true
    | "false"     -> bool_false

// ----- tokens -----
HEX: "$" /[0-9a-fA-F]+/
NOTE_NAME.2: /[A-G][#-][0-9][0-9]?/   // 2-digit octave: off-table pitches (97..255 = off-table reads)
SAMPLE_PATH.2: /[A-Za-z0-9_.][A-Za-z0-9_.\-]*\.flac/

%import common.CNAME
%import common.INT
%import common.SIGNED_FLOAT -> FLOAT
%import common.ESCAPED_STRING -> STRING
%import common.WS
%ignore WS

COMMENT: ";" /[^\n]*/
%ignore COMMENT
