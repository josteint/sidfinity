version: 2
engine: thing_on_a_spring

psid {
  title:      "Thing on a Spring"
  author:     "Rob Hubbard"
  released:   "1985 Gremlin Graphics"
  clock:      PAL
  sid:        6581
  start_song: 1
}

params {
  arp_interval: 24
  arp_period: 2
  first_frame_gate_off: false
  frame_ctr_init: 255
  freeze_on_stop: false
  has_incby2_late_gate: false
  has_stop_fill: false
  incby2_every_frame: true
  incby2_late_gate: -1
  incby2_onset: $00
  incby2_step: 1
  linear_pw_or: $00
  seed_overlap: true
  speed_ctr_init: 1
  stop_fill: $00
  suppress_first_notestart: false
  vib_onset: 6
}

init {
  voice 1 { ctrl: $41  dur_field: $57  pwm_period: $01  pwm_dir: up  instr: i15  slide_v: $3A }
